# SYLTRA Platform — environment template
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
API_PORT=3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=syltra
POSTGRES_PASSWORD=syltra_dev_password
POSTGRES_DB=syltra
DATABASE_URL=postgresql://syltra:syltra_dev_password@postgres:5432/syltra

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MQTT
MQTT_BROKER_URL=mqtt://mqtt:1883

# Auth (generate real random secrets before staging/production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# Docker Compose host-side port overrides — only needed if 5432/6379/1883/3000
# are already taken on your machine by something else. Leave unset otherwise.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MQTT_HOST_PORT=1883
# API_HOST_PORT=3000
